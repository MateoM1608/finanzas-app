# URL base del backend. En producción (Vercel) va VACÍO: el frontend llama a
# /api/* con rutas relativas y vercel.json lo reenvía al backend, así la cookie
# de sesión queda en el mismo dominio del frontend.
# En desarrollo local apunta al backend; si abres el frontend desde otra
# máquina, usa esa IP/dominio en vez de localhost.
VITE_API_URL="http://localhost:3001"
