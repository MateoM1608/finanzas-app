generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FrecuenciaCorte {
  semanal
  quincenal
  mensual
}

enum TipoGastoPersonal {
  recurrente
  puntual
}

enum OrigenGasto {
  app
  bot
}

enum TipoMontoConcepto {
  fijo
  variable
}

enum EstadoGastoPareja {
  pendiente
  incluido_en_corte
  liquidado
}

enum SplitContexto {
  general
  gastos_variables
}

model Usuario {
  id                 String   @id @default(uuid())
  nombre             String
  usuario            String   @unique
  passwordHash       String   @map("password_hash")
  hogarId            String?  @map("hogar_id")
  esAdmin            Boolean  @default(false) @map("es_admin")
  puedeEditarGastos  Boolean  @default(false) @map("puede_editar_gastos")
  puedeInvitar       Boolean  @default(false) @map("puede_invitar")
  creadoEn           DateTime @default(now()) @map("creado_en")

  hogar              Hogar?   @relation(fields: [hogarId], references: [id])
  invitacionesCreadas InvitacionHogar[] @relation("invitacionesCreadas")
  gastosPersonales   GastoPersonal[]
  splitPorcentajes   SplitPorcentajeMiembro[]
  transferenciasComoAnterior LogTransferenciaAdmin[] @relation("transferenciaAnterior")
  transferenciasComoNuevo    LogTransferenciaAdmin[] @relation("transferenciaNueva")
  conceptosComoPagadorDefault ConceptoRecurrentePareja[]
  gastosRecurrentesComoPagador GastoRecurrenteInstancia[] @relation("gastoRecurrentePagador")
  repartosGastoRecurrente GastoRecurrenteInstanciaReparto[] @relation("repartoGastoRecurrente")
  gastosVariablesComoPagador GastoVariablePareja[] @relation("gastoVariablePagador")
  repartosGastoVariable GastoVariableParejaReparto[] @relation("repartoGastoVariable")

  @@index([hogarId])
  @@map("usuarios")
}

model Hogar {
  id               String          @id @default(uuid())
  nombre           String
  frecuenciaCorte  FrecuenciaCorte @map("frecuencia_corte")
  creadoEn         DateTime        @default(now()) @map("creado_en")

  usuarios         Usuario[]
  puntosCorte      PuntoCorteHogar[]
  invitaciones     InvitacionHogar[]
  conceptosRecurrentes ConceptoRecurrentePareja[]
  splitPorcentajes SplitPorcentajeMiembro[]
  transferenciasAdmin LogTransferenciaAdmin[]
  gastosVariables  GastoVariablePareja[]

  @@map("hogares")
}

model PuntoCorteHogar {
  id         String @id @default(uuid())
  hogarId    String @map("hogar_id")
  orden      Int
  referencia String // etiqueta libre editable, ej. "dia_15", "fin_de_mes", "lunes"

  // Campos estructurales (no editables por el usuario) que maneja el cálculo de fechas,
  // independientes de "referencia" para que renombrar la etiqueta no rompa la lógica.
  diaMes     Int?   @map("dia_mes") // 1-31 para mensual/quincenal; null = último día del mes
  diaSemana  Int?   @map("dia_semana") // 1-7 (ISO, lunes=1) para semanal

  hogar     Hogar  @relation(fields: [hogarId], references: [id])
  conceptoPuntosCorte ConceptoPuntoCorte[]
  gastosRecurrentesInstancia GastoRecurrenteInstancia[]

  @@unique([hogarId, orden])
  @@index([hogarId])
  @@map("puntos_corte_hogar")
}

model InvitacionHogar {
  id                  String    @id @default(uuid())
  hogarId             String    @map("hogar_id")
  codigo              String    @unique
  usado               Boolean   @default(false)
  creadoPorUsuarioId  String    @map("creado_por_usuario_id")
  expiraEn            DateTime  @map("expira_en")
  creadoEn            DateTime  @default(now()) @map("creado_en")

  hogar               Hogar     @relation(fields: [hogarId], references: [id])
  creadoPor           Usuario   @relation("invitacionesCreadas", fields: [creadoPorUsuarioId], references: [id])

  @@index([hogarId])
  @@map("invitaciones_hogar")
}

model GastoPersonal {
  id          String            @id @default(uuid())
  usuarioId   String            @map("usuario_id")
  categoria   String?
  monto       Int
  fecha       DateTime
  descripcion String?
  tipo        TipoGastoPersonal @default(puntual)
  origen      OrigenGasto       @default(app)
  creadoEn    DateTime          @default(now()) @map("creado_en")

  usuario     Usuario           @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("gastos_personales")
}

model ConceptoRecurrentePareja {
  id                     String            @id @default(uuid())
  hogarId                String            @map("hogar_id")
  nombre                 String
  activo                 Boolean           @default(true)
  tipoMonto              TipoMontoConcepto @map("tipo_monto")
  montoDefault           Int?              @map("monto_default")
  pagadorDefaultUsuarioId String?          @map("pagador_default_usuario_id")
  creadoEn               DateTime          @default(now()) @map("creado_en")

  hogar          Hogar                @relation(fields: [hogarId], references: [id])
  pagadorDefault Usuario?             @relation(fields: [pagadorDefaultUsuarioId], references: [id])
  puntosCorte    ConceptoPuntoCorte[]
  instancias     GastoRecurrenteInstancia[]

  @@index([hogarId])
  @@map("conceptos_recurrentes_pareja")
}

model ConceptoPuntoCorte {
  id           String @id @default(uuid())
  conceptoId   String @map("concepto_id")
  puntoCorteId String @map("punto_corte_id")

  concepto     ConceptoRecurrentePareja @relation(fields: [conceptoId], references: [id])
  puntoCorte   PuntoCorteHogar          @relation(fields: [puntoCorteId], references: [id])

  @@unique([conceptoId, puntoCorteId])
  @@index([conceptoId])
  @@map("concepto_puntos_corte")
}

model SplitPorcentajeMiembro {
  id            String        @id @default(uuid())
  hogarId       String        @map("hogar_id")
  usuarioId     String        @map("usuario_id")
  porcentaje    Float
  contexto      SplitContexto @default(general)
  periodoInicio DateTime      @map("periodo_inicio")
  creadoEn      DateTime      @default(now()) @map("creado_en")

  hogar         Hogar    @relation(fields: [hogarId], references: [id])
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])

  @@unique([hogarId, usuarioId, periodoInicio, contexto])
  @@index([hogarId])
  @@map("split_porcentaje_miembro")
}

model LogTransferenciaAdmin {
  id                String   @id @default(uuid())
  hogarId           String   @map("hogar_id")
  usuarioAnteriorId String   @map("usuario_anterior_id")
  usuarioNuevoId    String   @map("usuario_nuevo_id")
  fecha             DateTime @default(now())

  hogar             Hogar    @relation(fields: [hogarId], references: [id])
  usuarioAnterior   Usuario  @relation("transferenciaAnterior", fields: [usuarioAnteriorId], references: [id])
  usuarioNuevo      Usuario  @relation("transferenciaNueva", fields: [usuarioNuevoId], references: [id])

  @@index([hogarId])
  @@map("log_transferencia_admin")
}

model GastoRecurrenteInstancia {
  id            String            @id @default(uuid())
  conceptoId    String            @map("concepto_id")
  periodoInicio DateTime          @map("periodo_inicio")
  puntoCorteId  String            @map("punto_corte_id")
  monto         Int?
  pagoUsuarioId String?           @map("pago_usuario_id")
  estado        EstadoGastoPareja @default(pendiente)
  creadoEn      DateTime          @default(now()) @map("creado_en")

  concepto   ConceptoRecurrentePareja @relation(fields: [conceptoId], references: [id])
  puntoCorte PuntoCorteHogar          @relation(fields: [puntoCorteId], references: [id])
  pagador    Usuario?                 @relation("gastoRecurrentePagador", fields: [pagoUsuarioId], references: [id])
  repartos   GastoRecurrenteInstanciaReparto[]

  @@unique([conceptoId, periodoInicio, puntoCorteId])
  @@index([puntoCorteId])
  @@map("gastos_recurrentes_instancia")
}

model GastoRecurrenteInstanciaReparto {
  id          String @id @default(uuid())
  instanciaId String @map("instancia_id")
  usuarioId   String @map("usuario_id")
  monto       Int

  instancia GastoRecurrenteInstancia @relation(fields: [instanciaId], references: [id])
  usuario   Usuario                  @relation("repartoGastoRecurrente", fields: [usuarioId], references: [id])

  @@unique([instanciaId, usuarioId])
  @@index([instanciaId])
  @@map("gastos_recurrentes_instancia_reparto")
}

model GastoVariablePareja {
  id            String            @id @default(uuid())
  hogarId       String            @map("hogar_id")
  item          String
  valorTotal    Int               @map("valor_total")
  pagoUsuarioId String            @map("pago_usuario_id")
  fechaLimite   DateTime          @map("fecha_limite")
  estado        EstadoGastoPareja @default(pendiente)
  fechaPagoReal DateTime?         @map("fecha_pago_real")
  creadoEn      DateTime          @default(now()) @map("creado_en")

  hogar    Hogar   @relation(fields: [hogarId], references: [id])
  pagador  Usuario @relation("gastoVariablePagador", fields: [pagoUsuarioId], references: [id])
  repartos GastoVariableParejaReparto[]

  @@index([hogarId])
  @@map("gastos_variables_pareja")
}

model GastoVariableParejaReparto {
  id        String @id @default(uuid())
  gastoId   String @map("gasto_id")
  usuarioId String @map("usuario_id")
  monto     Int

  gasto   GastoVariablePareja @relation(fields: [gastoId], references: [id])
  usuario Usuario             @relation("repartoGastoVariable", fields: [usuarioId], references: [id])

  @@unique([gastoId, usuarioId])
  @@index([gastoId])
  @@map("gastos_variables_pareja_reparto")
}
