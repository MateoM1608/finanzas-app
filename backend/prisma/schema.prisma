generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FrecuenciaCorte {
  semanal
  quincenal
  mensual
}

enum OrigenGasto {
  app
  bot
  corte_hogar
}

enum TipoMontoConcepto {
  fijo
  variable
}

enum EstadoGastoPareja {
  pendiente
  incluido_en_corte
  liquidado
}

enum SplitContexto {
  general
  gastos_variables
}

enum EstadoCorte {
  abierto
  cerrado
}

enum TipoOrigenCorteItem {
  recurrente
  variable
}

enum ModoFijoPersonal {
  automatico
  manual
}

enum EstadoPagoPersonal {
  pagado
  pendiente
}

enum EstadoIngresoPersonal {
  recibido
  pendiente
}

enum AplicaCategoriaPersonal {
  gasto
  ingreso
  ahorro
}

model Usuario {
  id                      String          @id @default(uuid())
  nombre                  String
  usuario                 String          @unique
  passwordHash            String          @map("password_hash")
  hogarId                 String?         @map("hogar_id")
  esAdmin                 Boolean         @default(false) @map("es_admin")
  puedeEditarGastos       Boolean         @default(false) @map("puede_editar_gastos")
  puedeInvitar            Boolean         @default(false) @map("puede_invitar")
  // Frecuencia del ciclo del panel personal (Disponible, Ahorros, Límites) —
  // independiente de la del hogar, sin historizar: no hay "puntos de corte"
  // configurables, cada ciclo se calcula puramente por calendario (ver
  // src/utils/cicloPersonal.js).
  frecuenciaCicloPersonal FrecuenciaCorte @default(mensual) @map("frecuencia_ciclo_personal")
  creadoEn                DateTime        @default(now()) @map("creado_en")

  hogar                        Hogar?                            @relation(fields: [hogarId], references: [id])
  invitacionesCreadas          InvitacionHogar[]                 @relation("invitacionesCreadas")
  gastosPersonales             GastoPersonal[]
  ingresosPersonales           IngresoPersonal[]
  metodosPagoPersonales        MetodoPagoPersonal[]
  categoriasPersonales         CategoriaPersonal[]
  gastosFijosConfig            GastoFijoConfig[]
  ingresosFijosConfig          IngresoFijoConfig[]
  ahorrosPersonales            AhorroPersonal[]
  periodosAhorroEvaluados      PeriodoAhorroEvaluado[]
  limitesAlertaPersonales      LimiteAlertaPersonal[]
  splitPorcentajes             SplitPorcentajeMiembro[]
  transferenciasComoAnterior   LogTransferenciaAdmin[]           @relation("transferenciaAnterior")
  transferenciasComoNuevo      LogTransferenciaAdmin[]           @relation("transferenciaNueva")
  conceptosComoPagadorDefault  ConceptoRecurrentePareja[]
  gastosRecurrentesComoPagador GastoRecurrenteInstancia[]        @relation("gastoRecurrentePagador")
  repartosGastoRecurrente      GastoRecurrenteInstanciaReparto[] @relation("repartoGastoRecurrente")
  gastosVariablesComoPagador   GastoVariablePareja[]             @relation("gastoVariablePagador")
  repartosGastoVariable        GastoVariableParejaReparto[]      @relation("repartoGastoVariable")
  cortesCreados                Corte[]                           @relation("corteCreadoPor")
  balancesCorte                CorteBalanceMiembro[]

  @@index([hogarId])
  @@map("usuarios")
}

model Hogar {
  id              String          @id @default(uuid())
  nombre          String
  frecuenciaCorte FrecuenciaCorte @map("frecuencia_corte")
  creadoEn        DateTime        @default(now()) @map("creado_en")

  usuarios             Usuario[]
  puntosCorte          PuntoCorteHogar[]
  invitaciones         InvitacionHogar[]
  conceptosRecurrentes ConceptoRecurrentePareja[]
  splitPorcentajes     SplitPorcentajeMiembro[]
  transferenciasAdmin  LogTransferenciaAdmin[]
  gastosVariables      GastoVariablePareja[]
  cortes               Corte[]

  @@map("hogares")
}

model PuntoCorteHogar {
  id         String @id @default(uuid())
  hogarId    String @map("hogar_id")
  orden      Int
  referencia String // etiqueta libre editable, ej. "dia_15", "fin_de_mes", "lunes"

  // Campos estructurales (no editables por el usuario) que maneja el cálculo de fechas,
  // independientes de "referencia" para que renombrar la etiqueta no rompa la lógica.
  diaMes    Int? @map("dia_mes") // 1-31 para mensual/quincenal; null = último día del mes
  diaSemana Int? @map("dia_semana") // 1-7 (ISO, lunes=1) para semanal

  hogar                      Hogar                      @relation(fields: [hogarId], references: [id])
  conceptoPuntosCorte        ConceptoPuntoCorte[]
  gastosRecurrentesInstancia GastoRecurrenteInstancia[]

  @@unique([hogarId, orden])
  @@index([hogarId])
  @@map("puntos_corte_hogar")
}

model InvitacionHogar {
  id                 String   @id @default(uuid())
  hogarId            String   @map("hogar_id")
  codigo             String   @unique
  usado              Boolean  @default(false)
  creadoPorUsuarioId String   @map("creado_por_usuario_id")
  expiraEn           DateTime @map("expira_en")
  creadoEn           DateTime @default(now()) @map("creado_en")

  hogar     Hogar   @relation(fields: [hogarId], references: [id])
  creadoPor Usuario @relation("invitacionesCreadas", fields: [creadoPorUsuarioId], references: [id])

  @@index([hogarId])
  @@map("invitaciones_hogar")
}

// --- Panel personal: catálogos + gastos/ingresos fijos-o-esporádicos ---
// Un gasto/ingreso "fijo" (con origenConfigId) y uno esporádico (sin él) viven
// en la misma tabla — no hay evento de "corte"/cierre: la fila generada por un
// fijo YA ES el gasto/ingreso real desde que existe (`estado` decide si ya
// afecta el disponible o sigue pendiente). Ver Modulo_Panel_Personal_Ajustes.md.

model MetodoPagoPersonal {
  id        String @id @default(uuid())
  usuarioId String @map("usuario_id")
  nombre    String

  usuario           Usuario           @relation(fields: [usuarioId], references: [id])
  gastos            GastoPersonal[]
  gastosFijosConfig GastoFijoConfig[]
  ingresos          IngresoPersonal[]

  @@index([usuarioId])
  @@map("metodos_pago_personales")
}

model CategoriaPersonal {
  id        String                    @id @default(uuid())
  usuarioId String                    @map("usuario_id")
  nombre    String
  aplicaA   AplicaCategoriaPersonal[] @map("aplica_a")

  usuario             Usuario                @relation(fields: [usuarioId], references: [id])
  gastos              GastoPersonal[]
  gastosFijosConfig   GastoFijoConfig[]
  ingresos            IngresoPersonal[]
  ingresosFijosConfig IngresoFijoConfig[]
  ahorros             AhorroPersonal[]
  limitesAlerta       LimiteAlertaPersonal[]

  @@index([usuarioId])
  @@map("categorias_personales")
}

model GastoFijoConfig {
  id                  String           @id @default(uuid())
  usuarioId           String           @map("usuario_id")
  nombre              String
  monto               Int
  frecuencia          FrecuenciaCorte
  // Ancla la primera ocurrencia — las siguientes se calculan sumando el paso de
  // la frecuencia (7/15/1 mes) desde acá, sin depender de "puntos de corte"
  // compartidos como el hogar (ver asegurarInstanciasFijas en gastosPersonales.service.js).
  fechaInicio         DateTime         @map("fecha_inicio")
  modoCobro           ModoFijoPersonal @map("modo_cobro")
  esObligatorio       Boolean          @default(false) @map("es_obligatorio")
  metodoPagoIdDefault String?          @map("metodo_pago_id_default")
  categoriaId         String?          @map("categoria_id")
  activo              Boolean          @default(true)
  creadoEn            DateTime         @default(now()) @map("creado_en")

  usuario           Usuario             @relation(fields: [usuarioId], references: [id])
  metodoPagoDefault MetodoPagoPersonal? @relation(fields: [metodoPagoIdDefault], references: [id])
  categoria         CategoriaPersonal?  @relation(fields: [categoriaId], references: [id])
  instancias        GastoPersonal[]

  @@index([usuarioId])
  @@map("gastos_fijos_config")
}

model IngresoFijoConfig {
  id          String           @id @default(uuid())
  usuarioId   String           @map("usuario_id")
  nombre      String
  monto       Int
  frecuencia  FrecuenciaCorte
  fechaInicio DateTime         @map("fecha_inicio")
  modo        ModoFijoPersonal
  categoriaId String?          @map("categoria_id")
  activo      Boolean          @default(true)
  creadoEn    DateTime         @default(now()) @map("creado_en")

  usuario    Usuario            @relation(fields: [usuarioId], references: [id])
  categoria  CategoriaPersonal? @relation(fields: [categoriaId], references: [id])
  instancias IngresoPersonal[]

  @@index([usuarioId])
  @@map("ingresos_fijos_config")
}

model GastoPersonal {
  id             String             @id @default(uuid())
  usuarioId      String             @map("usuario_id")
  origenConfigId String?            @map("origen_config_id")
  // Solo se llena cuando origen=corte_hogar: el corte de pareja que generó
  // este gasto (su parte del reparto de ese corte, ver cortes.service.js).
  origenCorteId  String?            @map("origen_corte_id")
  monto          Int
  fecha          DateTime
  descripcion    String?
  estado         EstadoPagoPersonal @default(pagado)
  esObligatorio  Boolean            @default(false) @map("es_obligatorio")
  metodoPagoId   String?            @map("metodo_pago_id")
  categoriaId    String?            @map("categoria_id")
  origen         OrigenGasto        @default(app)
  creadoEn       DateTime           @default(now()) @map("creado_en")

  usuario      Usuario             @relation(fields: [usuarioId], references: [id])
  origenConfig GastoFijoConfig?    @relation(fields: [origenConfigId], references: [id])
  origenCorte  Corte?              @relation(fields: [origenCorteId], references: [id])
  metodoPago   MetodoPagoPersonal? @relation(fields: [metodoPagoId], references: [id])
  categoria    CategoriaPersonal?  @relation(fields: [categoriaId], references: [id])

  @@unique([origenConfigId, fecha])
  @@unique([origenCorteId, usuarioId])
  @@index([usuarioId])
  @@map("gastos_personales")
}

model IngresoPersonal {
  id             String                @id @default(uuid())
  usuarioId      String                @map("usuario_id")
  origenConfigId String?               @map("origen_config_id")
  monto          Int
  fecha          DateTime
  estado         EstadoIngresoPersonal @default(recibido)
  metodoPagoId   String?               @map("metodo_pago_id")
  categoriaId    String?               @map("categoria_id")
  origen         OrigenGasto           @default(app)
  creadoEn       DateTime              @default(now()) @map("creado_en")

  usuario      Usuario             @relation(fields: [usuarioId], references: [id])
  origenConfig IngresoFijoConfig?  @relation(fields: [origenConfigId], references: [id])
  metodoPago   MetodoPagoPersonal? @relation(fields: [metodoPagoId], references: [id])
  categoria    CategoriaPersonal?  @relation(fields: [categoriaId], references: [id])

  @@unique([origenConfigId, fecha])
  @@index([usuarioId])
  @@map("ingresos_personales")
}

model ConceptoRecurrentePareja {
  id                      String            @id @default(uuid())
  hogarId                 String            @map("hogar_id")
  nombre                  String
  activo                  Boolean           @default(true)
  tipoMonto               TipoMontoConcepto @map("tipo_monto")
  montoDefault            Int?              @map("monto_default")
  pagadorDefaultUsuarioId String?           @map("pagador_default_usuario_id")
  creadoEn                DateTime          @default(now()) @map("creado_en")

  hogar          Hogar                      @relation(fields: [hogarId], references: [id])
  pagadorDefault Usuario?                   @relation(fields: [pagadorDefaultUsuarioId], references: [id])
  puntosCorte    ConceptoPuntoCorte[]
  instancias     GastoRecurrenteInstancia[]

  @@index([hogarId])
  @@map("conceptos_recurrentes_pareja")
}

model ConceptoPuntoCorte {
  id           String @id @default(uuid())
  conceptoId   String @map("concepto_id")
  puntoCorteId String @map("punto_corte_id")

  concepto   ConceptoRecurrentePareja @relation(fields: [conceptoId], references: [id])
  puntoCorte PuntoCorteHogar          @relation(fields: [puntoCorteId], references: [id])

  @@unique([conceptoId, puntoCorteId])
  @@index([conceptoId])
  @@map("concepto_puntos_corte")
}

model SplitPorcentajeMiembro {
  id            String        @id @default(uuid())
  hogarId       String        @map("hogar_id")
  usuarioId     String        @map("usuario_id")
  porcentaje    Float
  contexto      SplitContexto @default(general)
  periodoInicio DateTime      @map("periodo_inicio")
  creadoEn      DateTime      @default(now()) @map("creado_en")

  hogar   Hogar   @relation(fields: [hogarId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([hogarId, usuarioId, periodoInicio, contexto])
  @@index([hogarId])
  @@map("split_porcentaje_miembro")
}

model LogTransferenciaAdmin {
  id                String   @id @default(uuid())
  hogarId           String   @map("hogar_id")
  usuarioAnteriorId String   @map("usuario_anterior_id")
  usuarioNuevoId    String   @map("usuario_nuevo_id")
  fecha             DateTime @default(now())

  hogar           Hogar   @relation(fields: [hogarId], references: [id])
  usuarioAnterior Usuario @relation("transferenciaAnterior", fields: [usuarioAnteriorId], references: [id])
  usuarioNuevo    Usuario @relation("transferenciaNueva", fields: [usuarioNuevoId], references: [id])

  @@index([hogarId])
  @@map("log_transferencia_admin")
}

model GastoRecurrenteInstancia {
  id            String            @id @default(uuid())
  conceptoId    String            @map("concepto_id")
  periodoInicio DateTime          @map("periodo_inicio")
  puntoCorteId  String            @map("punto_corte_id")
  fechaNominal  DateTime          @map("fecha_nominal")
  monto         Int?
  pagoUsuarioId String?           @map("pago_usuario_id")
  estado        EstadoGastoPareja @default(pendiente)
  creadoEn      DateTime          @default(now()) @map("creado_en")

  concepto   ConceptoRecurrentePareja          @relation(fields: [conceptoId], references: [id])
  puntoCorte PuntoCorteHogar                   @relation(fields: [puntoCorteId], references: [id])
  pagador    Usuario?                          @relation("gastoRecurrentePagador", fields: [pagoUsuarioId], references: [id])
  repartos   GastoRecurrenteInstanciaReparto[]

  @@unique([conceptoId, periodoInicio, puntoCorteId])
  @@index([puntoCorteId])
  @@map("gastos_recurrentes_instancia")
}

model GastoRecurrenteInstanciaReparto {
  id          String @id @default(uuid())
  instanciaId String @map("instancia_id")
  usuarioId   String @map("usuario_id")
  monto       Int

  instancia GastoRecurrenteInstancia @relation(fields: [instanciaId], references: [id])
  usuario   Usuario                  @relation("repartoGastoRecurrente", fields: [usuarioId], references: [id])

  @@unique([instanciaId, usuarioId])
  @@index([instanciaId])
  @@map("gastos_recurrentes_instancia_reparto")
}

model GastoVariablePareja {
  id            String            @id @default(uuid())
  hogarId       String            @map("hogar_id")
  item          String
  valorTotal    Int               @map("valor_total")
  pagoUsuarioId String            @map("pago_usuario_id")
  fechaLimite   DateTime          @map("fecha_limite")
  estado        EstadoGastoPareja @default(pendiente)
  fechaPagoReal DateTime?         @map("fecha_pago_real")
  creadoEn      DateTime          @default(now()) @map("creado_en")

  hogar    Hogar                        @relation(fields: [hogarId], references: [id])
  pagador  Usuario                      @relation("gastoVariablePagador", fields: [pagoUsuarioId], references: [id])
  repartos GastoVariableParejaReparto[]

  @@index([hogarId])
  @@map("gastos_variables_pareja")
}

model GastoVariableParejaReparto {
  id        String @id @default(uuid())
  gastoId   String @map("gasto_id")
  usuarioId String @map("usuario_id")
  monto     Int

  gasto   GastoVariablePareja @relation(fields: [gastoId], references: [id])
  usuario Usuario             @relation("repartoGastoVariable", fields: [usuarioId], references: [id])

  @@unique([gastoId, usuarioId])
  @@index([gastoId])
  @@map("gastos_variables_pareja_reparto")
}

model Corte {
  id                 String      @id @default(uuid())
  hogarId            String      @map("hogar_id")
  fechaNominal       DateTime    @map("fecha_nominal")
  fechaEjecucion     DateTime?   @map("fecha_ejecucion")
  estado             EstadoCorte @default(abierto)
  creadoPorUsuarioId String      @map("creado_por_usuario_id")
  creadoEn           DateTime    @default(now()) @map("creado_en")

  hogar                     Hogar                 @relation(fields: [hogarId], references: [id])
  creadoPor                 Usuario               @relation("corteCreadoPor", fields: [creadoPorUsuarioId], references: [id])
  items                     CorteItem[]
  balances                  CorteBalanceMiembro[]
  gastosPersonalesGenerados GastoPersonal[]

  @@unique([hogarId, fechaNominal])
  @@index([hogarId])
  @@map("cortes")
}

model CorteItem {
  id         String              @id @default(uuid())
  corteId    String              @map("corte_id")
  tipoOrigen TipoOrigenCorteItem @map("tipo_origen")
  origenId   String              @map("origen_id")
  incluido   Boolean             @default(true)
  monto      Int?

  corte Corte @relation(fields: [corteId], references: [id])

  @@unique([corteId, tipoOrigen, origenId])
  @@index([corteId])
  @@map("corte_items")
}

model CorteBalanceMiembro {
  id        String @id @default(uuid())
  corteId   String @map("corte_id")
  usuarioId String @map("usuario_id")
  balance   Int // positivo = le deben, negativo = debe

  corte   Corte   @relation(fields: [corteId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([corteId, usuarioId])
  @@index([corteId])
  @@map("corte_balance_miembro")
}

// --- Panel personal: Ahorros con ciclos (Fase 7, Etapa 3) ---
// regla_tipo/regla_valor solo generan la sugerencia (AhorroPronostico), nunca
// mueven plata directamente; modo_transaccion=automatico es lo único que sí
// crea una AhorroTransaccion real, y usa el propio monto sugerido (no un
// monto aparte). monto_ahorrado_real y el color del semáforo NO se guardan
// como columna — se calculan en vivo sumando AhorroTransaccion dentro del
// rango del periodo ya evaluado (ver ahorrosPersonales.service.js).

enum ReglaAhorroTipo {
  porcentaje
  monto_fijo
}

enum BaseCalculoAhorro {
  ingreso_menos_obligatorios
  disponible_total
}

enum OrigenAhorroTransaccion {
  manual
  automatico
  bot
}

model AhorroPersonal {
  id              String            @id @default(uuid())
  usuarioId       String            @map("usuario_id")
  nombre          String
  montoMetaTotal  Int?              @map("monto_meta_total")
  reglaTipo       ReglaAhorroTipo   @map("regla_tipo")
  reglaValor      Int               @map("regla_valor")
  baseCalculo     BaseCalculoAhorro @default(ingreso_menos_obligatorios) @map("base_calculo")
  modoTransaccion ModoFijoPersonal  @map("modo_transaccion")
  categoriaId     String?           @map("categoria_id")
  activo          Boolean           @default(true)
  creadoEn        DateTime          @default(now()) @map("creado_en")

  usuario       Usuario             @relation(fields: [usuarioId], references: [id])
  categoria     CategoriaPersonal?  @relation(fields: [categoriaId], references: [id])
  transacciones AhorroTransaccion[]
  pronosticos   AhorroPronostico[]

  @@index([usuarioId])
  @@map("ahorros_personales")
}

model AhorroTransaccion {
  id       String                  @id @default(uuid())
  ahorroId String                  @map("ahorro_id")
  monto    Int
  fecha    DateTime
  origen   OrigenAhorroTransaccion @default(manual)
  creadoEn DateTime                @default(now()) @map("creado_en")

  ahorro AhorroPersonal @relation(fields: [ahorroId], references: [id])

  @@index([ahorroId])
  @@map("ahorro_transacciones")
}

model PeriodoAhorroEvaluado {
  id                          String   @id @default(uuid())
  usuarioId                   String   @map("usuario_id")
  periodoInicio               DateTime @map("periodo_inicio")
  periodoFin                  DateTime @map("periodo_fin")
  ingresoPeriodo              Int      @map("ingreso_periodo")
  gastosObligatoriosPeriodo   Int      @map("gastos_obligatorios_periodo")
  gastosNoObligatoriosPeriodo Int      @map("gastos_no_obligatorios_periodo")
  baseCalculoAhorro           Int      @map("base_calculo_ahorro")
  evaluadoEn                  DateTime @default(now()) @map("evaluado_en")

  usuario     Usuario            @relation(fields: [usuarioId], references: [id])
  pronosticos AhorroPronostico[]

  @@unique([usuarioId, periodoInicio])
  @@index([usuarioId])
  @@map("periodos_ahorro_evaluados")
}

model AhorroPronostico {
  id            String @id @default(uuid())
  ahorroId      String @map("ahorro_id")
  periodoId     String @map("periodo_id")
  montoSugerido Int    @map("monto_sugerido")

  ahorro  AhorroPersonal        @relation(fields: [ahorroId], references: [id])
  periodo PeriodoAhorroEvaluado @relation(fields: [periodoId], references: [id])

  @@unique([ahorroId, periodoId])
  @@index([periodoId])
  @@map("ahorro_pronosticos")
}

// --- Panel personal: Límites y alertas por categoría (Fase 7, Etapa 4) ---
// El período actual siempre se recalcula en vivo (nunca se guarda). El
// período anterior es el único "pasado" alcanzable hoy (la navegación
// histórica genérica es la Etapa 6) y se snapshotea la primera vez que se
// consulta, en LimiteEvaluadoPeriodo, para no reescribir el historial si el
// usuario cambia regla_valor más adelante (ver evaluacionLimite.js).

enum TipoObjetivoLimite {
  categoria
  obligatorios
  no_obligatorios
  todo_gasto
}

enum EstadoLimite {
  dentro
  excedido
}

model LimiteAlertaPersonal {
  id           String             @id @default(uuid())
  usuarioId    String             @map("usuario_id")
  nombre       String
  tipoObjetivo TipoObjetivoLimite @map("tipo_objetivo")
  categoriaId  String?            @map("categoria_id")
  reglaTipo    ReglaAhorroTipo    @map("regla_tipo")
  reglaValor   Int                @map("regla_valor")
  activo       Boolean            @default(true)
  creadoEn     DateTime           @default(now()) @map("creado_en")

  usuario      Usuario                 @relation(fields: [usuarioId], references: [id])
  categoria    CategoriaPersonal?      @relation(fields: [categoriaId], references: [id])
  evaluaciones LimiteEvaluadoPeriodo[]

  @@index([usuarioId])
  @@map("limites_alerta_personal")
}

model LimiteEvaluadoPeriodo {
  id                 String       @id @default(uuid())
  limiteId           String       @map("limite_id")
  periodoInicio      DateTime     @map("periodo_inicio")
  periodoFin         DateTime     @map("periodo_fin")
  reglaValorUsado    Int          @map("regla_valor_usado")
  limiteCalculado    Int          @map("limite_calculado")
  montoGastado       Int          @map("monto_gastado")
  disponibleRestante Int          @map("disponible_restante")
  estado             EstadoLimite
  evaluadoEn         DateTime     @default(now()) @map("evaluado_en")

  limite LimiteAlertaPersonal @relation(fields: [limiteId], references: [id])

  @@unique([limiteId, periodoInicio])
  @@index([limiteId])
  @@map("limites_evaluados_periodo")
}
