generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FrecuenciaCorte {
  semanal
  quincenal
  mensual
}

// Origen de un movimiento personal. Los de caja del hogar NO son consumo:
// - pago_hogar: el 100 % de un gasto del hogar que pagó este usuario (sale
//   de su plata; su parte de consumo se calcula aparte desde el hogar).
// - liquidacion_hogar: lo que pagó o recibió al cuadrar (un reintegro, no un
//   ingreso ni un gasto de consumo).
// - pago_tarjeta: el pago de una tarjeta de crédito (las compras con
//   tarjeta ya cuentan como consumo; el pago es lo que baja el Disponible).
// - cuadre_hogar: modelo anterior (la parte del miembro al cuadrar), ya no se genera.
enum OrigenGasto {
  app
  bot
  cuadre_hogar
  pago_hogar
  liquidacion_hogar
  pago_tarjeta
}

// Frecuencia propia de cada cuenta fija del hogar (ya no hay frecuencia de
// corte a nivel de hogar: los cuadres se hacen cuando el hogar decide).
enum FrecuenciaCuentaFija {
  mensual
  quincenal
}

enum TipoMontoConcepto {
  fijo
  variable
}

// Ciclo de un gasto del hogar (cuota de cuenta fija o gasto variable):
// por_pagar → pagado (ya alguien puso la plata, entra al saldo) → en_cuadre
// (incluido en el borrador de un cuadre) → cuadrado (cuadre confirmado).
// Desmarcarlo de un cuadre lo devuelve a `pagado`. Un gasto variable nace
// `pagado`: siempre se registra con quién pagó.
enum EstadoGastoHogar {
  por_pagar
  pagado
  en_cuadre
  cuadrado
}

enum SplitContexto {
  general
  gastos_variables
}

enum EstadoCuadre {
  abierto
  cerrado
}

enum TipoOrigenCuadreItem {
  recurrente
  variable
}

enum ModoFijoPersonal {
  automatico
  manual
}

enum EstadoPagoPersonal {
  pagado
  pendiente
}

enum EstadoIngresoPersonal {
  recibido
  pendiente
}

// Tipo de un método de pago personal. Tarjeta de crédito y crédito de
// almacén guardan su día de corte/pago para sugerir la fecha de la primera
// cuota de una compra a cuotas.
enum TipoMetodoPago {
  efectivo
  debito
  tarjeta_credito
  credito_almacen
  otro
}

enum AplicaCategoriaPersonal {
  gasto
  ingreso
  ahorro
}

model Usuario {
  id                      String          @id @default(uuid())
  nombre                  String
  usuario                 String          @unique
  passwordHash            String          @map("password_hash")
  hogarId                 String?         @map("hogar_id")
  esAdmin                 Boolean         @default(false) @map("es_admin")
  puedeEditarGastos       Boolean         @default(false) @map("puede_editar_gastos")
  puedeInvitar            Boolean         @default(false) @map("puede_invitar")
  // Frecuencia del ciclo del panel personal (Disponible, Ahorros, Límites) —
  // independiente de la del hogar, sin historizar: no hay "puntos de corte"
  // configurables, cada ciclo se calcula puramente por calendario (ver
  // src/utils/cicloPersonal.js).
  frecuenciaCicloPersonal FrecuenciaCorte @default(mensual) @map("frecuencia_ciclo_personal")
  creadoEn                DateTime        @default(now()) @map("creado_en")

  hogar                         Hogar?                            @relation(fields: [hogarId], references: [id])
  invitacionesCreadas           InvitacionHogar[]                 @relation("invitacionesCreadas")
  gastosPersonales              GastoPersonal[]
  ingresosPersonales            IngresoPersonal[]
  metodosPagoPersonales         MetodoPagoPersonal[]
  categoriasPersonales          CategoriaPersonal[]
  gastosFijosConfig             GastoFijoConfig[]
  ingresosFijosConfig           IngresoFijoConfig[]
  ahorrosPersonales             AhorroPersonal[]
  periodosAhorroEvaluados       PeriodoAhorroEvaluado[]
  limitesAlertaPersonales       LimiteAlertaPersonal[]
  splitPorcentajes              SplitPorcentajeMiembro[]
  transferenciasComoAnterior    LogTransferenciaAdmin[]           @relation("transferenciaAnterior")
  transferenciasComoNuevo       LogTransferenciaAdmin[]           @relation("transferenciaNueva")
  conceptosComoResponsable      ConceptoRecurrentePareja[]
  gastosRecurrentesComoPagador  GastoRecurrenteInstancia[]        @relation("gastoRecurrentePagador")
  repartosGastoRecurrente       GastoRecurrenteInstanciaReparto[] @relation("repartoGastoRecurrente")
  gastosVariablesComoPagador    GastoVariablePareja[]             @relation("gastoVariablePagador")
  repartosGastoVariable         GastoVariableParejaReparto[]      @relation("repartoGastoVariable")
  cuadresCreados                Cuadre[]                          @relation("cuadreCreadoPor")
  comprasCuotasPersonales       CompraCuotasPersonal[]
  comprasCuotasHogarComoPagador CompraCuotasHogar[]               @relation("compraHogarPagador")
  balancesCuadre                CuadreBalanceMiembro[]

  @@index([hogarId])
  @@map("usuarios")
}

model Hogar {
  id       String   @id @default(uuid())
  nombre   String
  creadoEn DateTime @default(now()) @map("creado_en")

  usuarios             Usuario[]
  invitaciones         InvitacionHogar[]
  conceptosRecurrentes ConceptoRecurrentePareja[]
  splitPorcentajes     SplitPorcentajeMiembro[]
  transferenciasAdmin  LogTransferenciaAdmin[]
  gastosVariables      GastoVariablePareja[]
  cuadres              Cuadre[]
  comprasCuotas        CompraCuotasHogar[]

  @@map("hogares")
}

model InvitacionHogar {
  id                 String   @id @default(uuid())
  hogarId            String   @map("hogar_id")
  codigo             String   @unique
  usado              Boolean  @default(false)
  creadoPorUsuarioId String   @map("creado_por_usuario_id")
  expiraEn           DateTime @map("expira_en")
  creadoEn           DateTime @default(now()) @map("creado_en")

  hogar     Hogar   @relation(fields: [hogarId], references: [id])
  creadoPor Usuario @relation("invitacionesCreadas", fields: [creadoPorUsuarioId], references: [id])

  @@index([hogarId])
  @@map("invitaciones_hogar")
}

// --- Panel personal: catálogos + gastos/ingresos fijos-o-esporádicos ---
// Un gasto/ingreso "fijo" (con origenConfigId) y uno esporádico (sin él) viven
// en la misma tabla — no hay evento de "corte"/cierre: la fila generada por un
// fijo YA ES el gasto/ingreso real desde que existe (`estado` decide si ya
// afecta el disponible o sigue pendiente). Ver Modulo_Panel_Personal_Ajustes.md.

// Datos de tarjeta: solo los que la app necesita (nunca el número completo,
// el código de seguridad ni la fecha de vencimiento). `ultimos4` es opcional,
// solo para reconocer la tarjeta.
model MetodoPagoPersonal {
  id             String         @id @default(uuid())
  usuarioId      String         @map("usuario_id")
  nombre         String
  tipo           TipoMetodoPago @default(otro)
  ultimos4       String?        @map("ultimos_4")
  diaCorte       Int?           @map("dia_corte")
  diaPago        Int?           @map("dia_pago")
  cupo           Int?
  // Tasa de la tarjeta o del crédito (% mensual) y cómo calcula el banco las
  // cuotas: las compras a cuotas con este método la heredan por defecto.
  tasaMensual    Float          @default(0) @map("tasa_mensual")
  sistemaInteres SistemaInteres @default(capital_fijo) @map("sistema_interes")

  usuario           Usuario                    @relation(fields: [usuarioId], references: [id])
  gastos            GastoPersonal[]
  gastosFijosConfig GastoFijoConfig[]
  ingresos          IngresoPersonal[]
  comprasPersonales CompraCuotasPersonal[]
  comprasHogar      CompraCuotasHogar[]
  pagosCuentasHogar GastoRecurrenteInstancia[]
  pagosGastosHogar  GastoVariablePareja[]
  pagosRecibidos    GastoPersonal[]            @relation("pagoTarjeta")

  @@index([usuarioId])
  @@map("metodos_pago_personales")
}

model CategoriaPersonal {
  id        String                    @id @default(uuid())
  usuarioId String                    @map("usuario_id")
  nombre    String
  aplicaA   AplicaCategoriaPersonal[] @map("aplica_a")

  usuario             Usuario                @relation(fields: [usuarioId], references: [id])
  gastos              GastoPersonal[]
  gastosFijosConfig   GastoFijoConfig[]
  ingresos            IngresoPersonal[]
  ingresosFijosConfig IngresoFijoConfig[]
  ahorros             AhorroPersonal[]
  limitesAlerta       LimiteAlertaPersonal[]
  comprasCuotas       CompraCuotasPersonal[]

  @@index([usuarioId])
  @@map("categorias_personales")
}

model GastoFijoConfig {
  id                  String           @id @default(uuid())
  usuarioId           String           @map("usuario_id")
  nombre              String
  monto               Int
  frecuencia          FrecuenciaCorte
  // Ancla la primera ocurrencia — las siguientes se calculan sumando el paso de
  // la frecuencia (7/15/1 mes) desde acá, sin depender de "puntos de corte"
  // compartidos como el hogar (ver asegurarInstanciasFijas en gastosPersonales.service.js).
  fechaInicio         DateTime         @map("fecha_inicio")
  modoCobro           ModoFijoPersonal @map("modo_cobro")
  esObligatorio       Boolean          @default(false) @map("es_obligatorio")
  metodoPagoIdDefault String?          @map("metodo_pago_id_default")
  categoriaId         String?          @map("categoria_id")
  activo              Boolean          @default(true)
  creadoEn            DateTime         @default(now()) @map("creado_en")

  usuario           Usuario             @relation(fields: [usuarioId], references: [id])
  metodoPagoDefault MetodoPagoPersonal? @relation(fields: [metodoPagoIdDefault], references: [id])
  categoria         CategoriaPersonal?  @relation(fields: [categoriaId], references: [id])
  instancias        GastoPersonal[]

  @@index([usuarioId])
  @@map("gastos_fijos_config")
}

model IngresoFijoConfig {
  id          String           @id @default(uuid())
  usuarioId   String           @map("usuario_id")
  nombre      String
  monto       Int
  frecuencia  FrecuenciaCorte
  fechaInicio DateTime         @map("fecha_inicio")
  modo        ModoFijoPersonal
  categoriaId String?          @map("categoria_id")
  activo      Boolean          @default(true)
  creadoEn    DateTime         @default(now()) @map("creado_en")

  usuario    Usuario            @relation(fields: [usuarioId], references: [id])
  categoria  CategoriaPersonal? @relation(fields: [categoriaId], references: [id])
  instancias IngresoPersonal[]

  @@index([usuarioId])
  @@map("ingresos_fijos_config")
}

model GastoPersonal {
  id             String             @id @default(uuid())
  usuarioId      String             @map("usuario_id")
  origenConfigId String?            @map("origen_config_id")
  // Solo se llena cuando origen=cuadre_hogar: el cuadre del hogar que generó
  // este gasto (la parte de este miembro en los ítems de un mes de ese
  // cuadre — un cuadre que abarca varios meses genera un gasto por mes, ver
  // cuadres.service.js).
  origenCuadreId String?            @map("origen_cuadre_id")
  monto          Int
  fecha          DateTime
  descripcion    String?
  estado         EstadoPagoPersonal @default(pagado)
  esObligatorio  Boolean            @default(false) @map("es_obligatorio")
  metodoPagoId   String?            @map("metodo_pago_id")
  categoriaId    String?            @map("categoria_id")
  origen         OrigenGasto        @default(app)
  // Cuota de una compra a cuotas personal (numeroCuota 1..N), o movimiento
  // de caja de una cuota del hogar: capital + interés = monto.
  compraId       String?            @map("compra_id")
  numeroCuota    Int?               @map("numero_cuota")
  capital        Int?
  interes        Int?
  creadoEn       DateTime           @default(now()) @map("creado_en")

  // Movimiento de caja del pago de un gasto del hogar (origen pago_hogar):
  // se borra solo si se borra ese gasto del hogar.
  pagoCuotaHogarId String? @unique @map("pago_cuota_hogar_id")
  pagoGastoHogarId String? @unique @map("pago_gasto_hogar_id")
  // Pago de tarjeta (origen pago_tarjeta): la tarjeta que se pagó.
  tarjetaPagadaId  String? @map("tarjeta_pagada_id")

  usuario        Usuario                   @relation(fields: [usuarioId], references: [id])
  compra         CompraCuotasPersonal?     @relation(fields: [compraId], references: [id])
  pagoCuotaHogar GastoRecurrenteInstancia? @relation(fields: [pagoCuotaHogarId], references: [id], onDelete: Cascade)
  pagoGastoHogar GastoVariablePareja?      @relation(fields: [pagoGastoHogarId], references: [id], onDelete: Cascade)
  tarjetaPagada  MetodoPagoPersonal?       @relation("pagoTarjeta", fields: [tarjetaPagadaId], references: [id])
  origenConfig   GastoFijoConfig?          @relation(fields: [origenConfigId], references: [id])
  origenCuadre   Cuadre?                   @relation(fields: [origenCuadreId], references: [id])
  metodoPago     MetodoPagoPersonal?       @relation(fields: [metodoPagoId], references: [id])
  categoria      CategoriaPersonal?        @relation(fields: [categoriaId], references: [id])

  @@unique([origenConfigId, fecha])
  @@unique([origenCuadreId, usuarioId, fecha])
  @@unique([compraId, numeroCuota])
  @@index([usuarioId])
  @@map("gastos_personales")
}

model IngresoPersonal {
  id             String                @id @default(uuid())
  usuarioId      String                @map("usuario_id")
  origenConfigId String?               @map("origen_config_id")
  monto          Int
  fecha          DateTime
  descripcion    String?
  estado         EstadoIngresoPersonal @default(recibido)
  metodoPagoId   String?               @map("metodo_pago_id")
  categoriaId    String?               @map("categoria_id")
  origen         OrigenGasto           @default(app)
  creadoEn       DateTime              @default(now()) @map("creado_en")

  // Reintegro recibido al cuadrar (origen liquidacion_hogar).
  origenCuadreId String? @map("origen_cuadre_id")

  usuario      Usuario             @relation(fields: [usuarioId], references: [id])
  origenCuadre Cuadre?             @relation(fields: [origenCuadreId], references: [id])
  origenConfig IngresoFijoConfig?  @relation(fields: [origenConfigId], references: [id])
  metodoPago   MetodoPagoPersonal? @relation(fields: [metodoPagoId], references: [id])
  categoria    CategoriaPersonal?  @relation(fields: [categoriaId], references: [id])

  @@unique([origenConfigId, fecha])
  @@unique([origenCuadreId, usuarioId])
  @@index([usuarioId])
  @@map("ingresos_personales")
}

// Cuenta fija del hogar (arriendo, internet…). Cada una lleva su propio
// calendario: `frecuencia` + día(s) del mes, desde `fechaInicio`. Mensual usa
// `diaMes`; quincenal usa `diaMes` y `diaMes2`. Un día null = último día del
// mes, y un día mayor que el largo del mes cae en su último día (30 en
// febrero → 28/29). Las cuotas se generan perezosamente (utils/cuentasFijas.js).
model ConceptoRecurrentePareja {
  id                   String               @id @default(uuid())
  hogarId              String               @map("hogar_id")
  nombre               String
  activo               Boolean              @default(true)
  tipoMonto            TipoMontoConcepto    @map("tipo_monto")
  montoDefault         Int?                 @map("monto_default")
  responsableUsuarioId String?              @map("responsable_usuario_id")
  frecuencia           FrecuenciaCuentaFija @default(mensual)
  diaMes               Int?                 @map("dia_mes")
  diaMes2              Int?                 @map("dia_mes_2")
  fechaInicio          DateTime             @map("fecha_inicio")
  creadoEn             DateTime             @default(now()) @map("creado_en")

  hogar       Hogar                      @relation(fields: [hogarId], references: [id])
  responsable Usuario?                   @relation(fields: [responsableUsuarioId], references: [id])
  instancias  GastoRecurrenteInstancia[]

  @@index([hogarId])
  @@map("conceptos_recurrentes_pareja")
}

model SplitPorcentajeMiembro {
  id            String        @id @default(uuid())
  hogarId       String        @map("hogar_id")
  usuarioId     String        @map("usuario_id")
  porcentaje    Float
  contexto      SplitContexto @default(general)
  periodoInicio DateTime      @map("periodo_inicio")
  creadoEn      DateTime      @default(now()) @map("creado_en")

  hogar   Hogar   @relation(fields: [hogarId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([hogarId, usuarioId, periodoInicio, contexto])
  @@index([hogarId])
  @@map("split_porcentaje_miembro")
}

model LogTransferenciaAdmin {
  id                String   @id @default(uuid())
  hogarId           String   @map("hogar_id")
  usuarioAnteriorId String   @map("usuario_anterior_id")
  usuarioNuevoId    String   @map("usuario_nuevo_id")
  fecha             DateTime @default(now())

  hogar           Hogar   @relation(fields: [hogarId], references: [id])
  usuarioAnterior Usuario @relation("transferenciaAnterior", fields: [usuarioAnteriorId], references: [id])
  usuarioNuevo    Usuario @relation("transferenciaNueva", fields: [usuarioNuevoId], references: [id])

  @@index([hogarId])
  @@map("log_transferencia_admin")
}

// Cuota de una cuenta fija en una fecha. Nace `por_pagar` (monto = el de la
// cuenta si es fija, null si es variable, sin pagador) y solo pasa a
// `pagado` — y entra al saldo/cuadre — cuando alguien la marca como pagada.
model GastoRecurrenteInstancia {
  id            String           @id @default(uuid())
  conceptoId    String           @map("concepto_id")
  fecha         DateTime
  monto         Int?
  pagoUsuarioId String?          @map("pago_usuario_id")
  fechaPago     DateTime?        @map("fecha_pago")
  // Método de pago personal con el que se pagó (privado: solo lo ve quien pagó).
  metodoPagoId  String?          @map("metodo_pago_id")
  estado        EstadoGastoHogar @default(por_pagar)
  creadoEn      DateTime         @default(now()) @map("creado_en")

  concepto       ConceptoRecurrentePareja          @relation(fields: [conceptoId], references: [id])
  pagador        Usuario?                          @relation("gastoRecurrentePagador", fields: [pagoUsuarioId], references: [id])
  metodoPago     MetodoPagoPersonal?               @relation(fields: [metodoPagoId], references: [id])
  movimientoPago GastoPersonal?
  repartos       GastoRecurrenteInstanciaReparto[]

  @@unique([conceptoId, fecha])
  @@index([conceptoId, estado])
  @@map("gastos_recurrentes_instancia")
}

model GastoRecurrenteInstanciaReparto {
  id          String @id @default(uuid())
  instanciaId String @map("instancia_id")
  usuarioId   String @map("usuario_id")
  monto       Int

  instancia GastoRecurrenteInstancia @relation(fields: [instanciaId], references: [id])
  usuario   Usuario                  @relation("repartoGastoRecurrente", fields: [usuarioId], references: [id])

  @@unique([instanciaId, usuarioId])
  @@index([instanciaId])
  @@map("gastos_recurrentes_instancia_reparto")
}

// Gasto puntual del hogar (mercado, una compra…): `fecha` es el día del
// gasto. Nace `pagado` porque siempre se registra con quién pagó.
model GastoVariablePareja {
  id            String           @id @default(uuid())
  hogarId       String           @map("hogar_id")
  item          String
  valorTotal    Int              @map("valor_total")
  pagoUsuarioId String           @map("pago_usuario_id")
  fecha         DateTime
  estado        EstadoGastoHogar @default(pagado)
  // Cuota de una compra a cuotas del hogar (numeroCuota 1..N). Si la compra
  // es de cobro manual la cuota nace `por_pagar` y alguien la marca pagada.
  compraId      String?          @map("compra_id")
  numeroCuota   Int?             @map("numero_cuota")
  capital       Int?
  interes       Int?
  fechaPago     DateTime?        @map("fecha_pago")
  // Método de pago personal con el que se pagó (privado: solo lo ve quien pagó).
  metodoPagoId  String?          @map("metodo_pago_id")
  creadoEn      DateTime         @default(now()) @map("creado_en")

  hogar          Hogar                        @relation(fields: [hogarId], references: [id])
  pagador        Usuario                      @relation("gastoVariablePagador", fields: [pagoUsuarioId], references: [id])
  metodoPago     MetodoPagoPersonal?          @relation(fields: [metodoPagoId], references: [id])
  movimientoPago GastoPersonal?
  compra         CompraCuotasHogar?           @relation(fields: [compraId], references: [id])
  repartos       GastoVariableParejaReparto[]

  @@unique([compraId, numeroCuota])
  @@index([hogarId, estado])
  @@map("gastos_variables_pareja")
}

model GastoVariableParejaReparto {
  id        String @id @default(uuid())
  gastoId   String @map("gasto_id")
  usuarioId String @map("usuario_id")
  monto     Int

  gasto   GastoVariablePareja @relation(fields: [gastoId], references: [id])
  usuario Usuario             @relation("repartoGastoVariable", fields: [usuarioId], references: [id])

  @@unique([gastoId, usuarioId])
  @@index([gastoId])
  @@map("gastos_variables_pareja_reparto")
}

// Cuadre de cuentas: lo inicia el hogar cuando quiere (sin fechas de corte).
// Mientras está `abierto` es un borrador que se refresca en cada consulta con
// lo pagado y sin cuadrar hasta hoy; al confirmarlo queda `cerrado` con su
// `fecha` (el día del cuadre). Máximo un borrador abierto por hogar.
model Cuadre {
  id                 String       @id @default(uuid())
  hogarId            String       @map("hogar_id")
  fecha              DateTime?
  estado             EstadoCuadre @default(abierto)
  creadoPorUsuarioId String       @map("creado_por_usuario_id")
  creadoEn           DateTime     @default(now()) @map("creado_en")
  cerradoEn          DateTime?    @map("cerrado_en")

  hogar                     Hogar                  @relation(fields: [hogarId], references: [id])
  creadoPor                 Usuario                @relation("cuadreCreadoPor", fields: [creadoPorUsuarioId], references: [id])
  items                     CuadreItem[]
  balances                  CuadreBalanceMiembro[]
  gastosPersonalesGenerados GastoPersonal[]
  ingresosPersonales        IngresoPersonal[]

  @@index([hogarId, estado])
  @@map("cuadres")
}

model CuadreItem {
  id         String               @id @default(uuid())
  cuadreId   String               @map("cuadre_id")
  tipoOrigen TipoOrigenCuadreItem @map("tipo_origen")
  origenId   String               @map("origen_id")
  incluido   Boolean              @default(true)
  monto      Int

  cuadre Cuadre @relation(fields: [cuadreId], references: [id])

  @@unique([cuadreId, tipoOrigen, origenId])
  @@index([cuadreId])
  @@map("cuadre_items")
}

model CuadreBalanceMiembro {
  id        String @id @default(uuid())
  cuadreId  String @map("cuadre_id")
  usuarioId String @map("usuario_id")
  balance   Int // positivo = le deben, negativo = debe

  cuadre  Cuadre  @relation(fields: [cuadreId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([cuadreId, usuarioId])
  @@index([cuadreId])
  @@map("cuadre_balance_miembro")
}

// --- Panel personal: Ahorros con ciclos (Fase 7, Etapa 3) ---
// regla_tipo/regla_valor solo generan la sugerencia (AhorroPronostico), nunca
// mueven plata directamente; modo_transaccion=automatico es lo único que sí
// crea una AhorroTransaccion real, y usa el propio monto sugerido (no un
// monto aparte). monto_ahorrado_real y el color del semáforo NO se guardan
// como columna — se calculan en vivo sumando AhorroTransaccion dentro del
// rango del periodo ya evaluado (ver ahorrosPersonales.service.js).

enum ReglaAhorroTipo {
  porcentaje
  monto_fijo
}

enum BaseCalculoAhorro {
  ingreso_menos_obligatorios
  disponible_total
}

enum OrigenAhorroTransaccion {
  manual
  automatico
  bot
}

model AhorroPersonal {
  id              String            @id @default(uuid())
  usuarioId       String            @map("usuario_id")
  nombre          String
  montoMetaTotal  Int?              @map("monto_meta_total")
  reglaTipo       ReglaAhorroTipo   @map("regla_tipo")
  reglaValor      Int               @map("regla_valor")
  baseCalculo     BaseCalculoAhorro @default(ingreso_menos_obligatorios) @map("base_calculo")
  modoTransaccion ModoFijoPersonal  @map("modo_transaccion")
  categoriaId     String?           @map("categoria_id")
  activo          Boolean           @default(true)
  creadoEn        DateTime          @default(now()) @map("creado_en")

  usuario       Usuario             @relation(fields: [usuarioId], references: [id])
  categoria     CategoriaPersonal?  @relation(fields: [categoriaId], references: [id])
  transacciones AhorroTransaccion[]
  pronosticos   AhorroPronostico[]

  @@index([usuarioId])
  @@map("ahorros_personales")
}

model AhorroTransaccion {
  id       String                  @id @default(uuid())
  ahorroId String                  @map("ahorro_id")
  monto    Int
  fecha    DateTime
  origen   OrigenAhorroTransaccion @default(manual)
  creadoEn DateTime                @default(now()) @map("creado_en")

  ahorro AhorroPersonal @relation(fields: [ahorroId], references: [id])

  @@index([ahorroId])
  @@map("ahorro_transacciones")
}

model PeriodoAhorroEvaluado {
  id                          String   @id @default(uuid())
  usuarioId                   String   @map("usuario_id")
  periodoInicio               DateTime @map("periodo_inicio")
  periodoFin                  DateTime @map("periodo_fin")
  ingresoPeriodo              Int      @map("ingreso_periodo")
  gastosObligatoriosPeriodo   Int      @map("gastos_obligatorios_periodo")
  gastosNoObligatoriosPeriodo Int      @map("gastos_no_obligatorios_periodo")
  baseCalculoAhorro           Int      @map("base_calculo_ahorro")
  evaluadoEn                  DateTime @default(now()) @map("evaluado_en")

  usuario     Usuario            @relation(fields: [usuarioId], references: [id])
  pronosticos AhorroPronostico[]

  @@unique([usuarioId, periodoInicio])
  @@index([usuarioId])
  @@map("periodos_ahorro_evaluados")
}

model AhorroPronostico {
  id            String @id @default(uuid())
  ahorroId      String @map("ahorro_id")
  periodoId     String @map("periodo_id")
  montoSugerido Int    @map("monto_sugerido")

  ahorro  AhorroPersonal        @relation(fields: [ahorroId], references: [id])
  periodo PeriodoAhorroEvaluado @relation(fields: [periodoId], references: [id])

  @@unique([ahorroId, periodoId])
  @@index([periodoId])
  @@map("ahorro_pronosticos")
}

// --- Panel personal: Límites y alertas por categoría (Fase 7, Etapa 4) ---
// El período actual siempre se recalcula en vivo (nunca se guarda). El
// período anterior es el único "pasado" alcanzable hoy (la navegación
// histórica genérica es la Etapa 6) y se snapshotea la primera vez que se
// consulta, en LimiteEvaluadoPeriodo, para no reescribir el historial si el
// usuario cambia regla_valor más adelante (ver evaluacionLimite.js).

enum TipoObjetivoLimite {
  categoria
  obligatorios
  no_obligatorios
  todo_gasto
}

enum EstadoLimite {
  dentro
  excedido
}

model LimiteAlertaPersonal {
  id           String             @id @default(uuid())
  usuarioId    String             @map("usuario_id")
  nombre       String
  tipoObjetivo TipoObjetivoLimite @map("tipo_objetivo")
  categoriaId  String?            @map("categoria_id")
  reglaTipo    ReglaAhorroTipo    @map("regla_tipo")
  reglaValor   Int                @map("regla_valor")
  activo       Boolean            @default(true)
  creadoEn     DateTime           @default(now()) @map("creado_en")

  usuario      Usuario                 @relation(fields: [usuarioId], references: [id])
  categoria    CategoriaPersonal?      @relation(fields: [categoriaId], references: [id])
  evaluaciones LimiteEvaluadoPeriodo[]

  @@index([usuarioId])
  @@map("limites_alerta_personal")
}

model LimiteEvaluadoPeriodo {
  id                 String       @id @default(uuid())
  limiteId           String       @map("limite_id")
  periodoInicio      DateTime     @map("periodo_inicio")
  periodoFin         DateTime     @map("periodo_fin")
  reglaValorUsado    Int          @map("regla_valor_usado")
  limiteCalculado    Int          @map("limite_calculado")
  montoGastado       Int          @map("monto_gastado")
  disponibleRestante Int          @map("disponible_restante")
  estado             EstadoLimite
  evaluadoEn         DateTime     @default(now()) @map("evaluado_en")

  limite LimiteAlertaPersonal @relation(fields: [limiteId], references: [id])

  @@unique([limiteId, periodoInicio])
  @@index([limiteId])
  @@map("limites_evaluados_periodo")
}

// Cómo se calculan las cuotas de una compra con interés (tasaMensual > 0):
// - capital_fijo: abono a capital fijo (total/N) + interés sobre el saldo
//   que falta; las cuotas van bajando (lo usual en tarjetas en Colombia).
// - cuota_fija: sistema francés, todas las cuotas iguales.
enum SistemaInteres {
  capital_fijo
  cuota_fija
}

// --- Compras a cuotas (entrega B) ---
// Una compra a cuotas crea de una vez todas sus cuotas como gastos normales
// (GastoPersonal / GastoVariablePareja) con `compraId` + `numeroCuota`. Monto
// de cada cuota = total / N, el residuo va en la última. `modoCobro`:
// automatico (tarjeta, débito automático: la cuota se da por pagada en su
// fecha) o manual (crédito de almacén: alguien la marca pagada).

model CompraCuotasPersonal {
  id                String           @id @default(uuid())
  usuarioId         String           @map("usuario_id")
  descripcion       String
  montoTotal        Int              @map("monto_total")
  numeroCuotas      Int              @map("numero_cuotas")
  fechaPrimeraCuota DateTime         @map("fecha_primera_cuota")
  modoCobro         ModoFijoPersonal @map("modo_cobro")
  metodoPagoId      String?          @map("metodo_pago_id")
  categoriaId       String?          @map("categoria_id")
  esObligatorio     Boolean          @default(true) @map("es_obligatorio")
  // Interés: tasa mensual en % (0 = sin interés) y cómo se calcula.
  tasaMensual       Float            @default(0) @map("tasa_mensual")
  sistemaInteres    SistemaInteres   @default(capital_fijo) @map("sistema_interes")
  creadoEn          DateTime         @default(now()) @map("creado_en")

  usuario    Usuario             @relation(fields: [usuarioId], references: [id])
  metodoPago MetodoPagoPersonal? @relation(fields: [metodoPagoId], references: [id])
  categoria  CategoriaPersonal?  @relation(fields: [categoriaId], references: [id])
  cuotas     GastoPersonal[]

  @@index([usuarioId])
  @@map("compras_cuotas_personales")
}

// El método de pago es del pagador (privado): solo se expone a quien pagó.
// El reparto de todas las cuotas usa el split vigente el día de la compra.
model CompraCuotasHogar {
  id                String           @id @default(uuid())
  hogarId           String           @map("hogar_id")
  item              String
  montoTotal        Int              @map("monto_total")
  numeroCuotas      Int              @map("numero_cuotas")
  fechaCompra       DateTime         @map("fecha_compra")
  fechaPrimeraCuota DateTime         @map("fecha_primera_cuota")
  modoCobro         ModoFijoPersonal @map("modo_cobro")
  pagoUsuarioId     String           @map("pago_usuario_id")
  metodoPagoId      String?          @map("metodo_pago_id")
  tasaMensual       Float            @default(0) @map("tasa_mensual")
  sistemaInteres    SistemaInteres   @default(capital_fijo) @map("sistema_interes")
  creadoEn          DateTime         @default(now()) @map("creado_en")

  hogar      Hogar                 @relation(fields: [hogarId], references: [id])
  pagador    Usuario               @relation("compraHogarPagador", fields: [pagoUsuarioId], references: [id])
  metodoPago MetodoPagoPersonal?   @relation(fields: [metodoPagoId], references: [id])
  cuotas     GastoVariablePareja[]

  @@index([hogarId])
  @@map("compras_cuotas_hogar")
}
