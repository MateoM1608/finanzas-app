# URL base del backend. Déjalo VACÍO en desarrollo y en producción:
# - desarrollo: vite.config.js reenvía /api al backend local (localhost:3001);
# - producción (Vercel): frontend/vercel.json reenvía /api al proyecto del backend.
# Así la cookie de sesión queda siempre en el mismo dominio del frontend.
VITE_API_URL=
