# En Vercel (serverless) agrega connection_limit para no agotar las conexiones
# de Postgres, ej.: ...?sslmode=disable&connection_limit=3&pool_timeout=20
# (sslmode=disable es temporal: ver backlog de CLAUDE.md antes de producción).
DATABASE_URL="postgres://usuario:password@host:puerto/nombre_db"
# Conexión directa, solo para migraciones. En pruebas (VPS) es la misma de arriba;
# en producción (Supabase) DATABASE_URL es el pooler (puerto 6543, ?pgbouncer=true&connection_limit=1)
# y DIRECT_URL la conexión directa o de sesión (puerto 5432).
DIRECT_URL="${DATABASE_URL}"
JWT_SECRET="reemplazar-con-un-secreto-largo-y-aleatorio"
PORT=3001
NODE_ENV=development
# Zona horaria con la que se calcula "hoy" (default America/Bogota).
APP_TZ=America/Bogota
# Orígenes (separados por coma) a los que CORS acepta credenciales. Vacío = cualquiera (solo dev).
FRONTEND_URL=
